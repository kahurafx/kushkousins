# The Next.js server (API + auth). Pick the line for how you run the app:
# iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000
# Android emulator (10.0.2.2 is the host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Physical device on the same Wi-Fi: your computer's LAN IP, and start web with `pnpm --filter @repo/web exec next dev -H 0.0.0.0`
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
