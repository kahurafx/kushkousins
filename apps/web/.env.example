# Next.js loads .env* from this folder; copy the root .env.example values here as .env.local
DATABASE_URL=postgres://postgres:postgres@localhost:54329/kushkousins
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DEV ONLY: checkout marks orders paid without M-Pesa (ignored in production builds). Overrides the M-Pesa settings below.
# MOCK_PAYMENTS=true

# ---- M-Pesa (Daraja STK Push). Leave unset and checkout says payments aren't set up yet.
# Sandbox keys: developer.safaricom.co.ke → My Apps. Sandbox shortcode 174379 uses the passkey shown on the
# portal's M-Pesa Express simulator page.
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill number, or the store number for Buy Goods
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline | CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Buy Goods only: the till number (defaults to MPESA_SHORTCODE)
# MPESA_PARTY_B=
# Public HTTPS origin Safaricom can reach (in dev: a tunnel such as `ngrok http 3000`). No path.
MPESA_CALLBACK_URL=https://your-tunnel.example
# Random string; becomes part of the callback path. Generate: openssl rand -hex 24
MPESA_CALLBACK_SECRET=

# Scheduled sweep (GET /api/cron/release-reservations with `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET=
